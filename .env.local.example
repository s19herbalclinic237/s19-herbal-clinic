# MongoDB
MONGO_URL=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/s19-medical

# SMTP (e.g. Gmail, Zoho, Mailgun)
SMTP_HOST=smtp.zoho.com
SMTP_PORT=465
SMTP_USER=info@s19herbalclinic.com
SMTP_PASS=your-zoho-smtp-password
SMTP_FROM=S19 Herbal Clinic <info@s19herbalclinic.com>
ADMIN_EMAIL=info@s19herbalclinic.com

# Sessions
# Absolute session lifetime is 30 days. On top of that, a session is ended after
# this many minutes without activity so a shared or abandoned device does not
# stay signed in. The client sends a heartbeat while the user is active, so real
# use never trips it. Set both to keep the client and server clocks in step.
# SESSION_IDLE_MINUTES=30
# NEXT_PUBLIC_IDLE_TIMEOUT_MINUTES=30

# Cloudinary
CLOUDINARY_CLOUD_NAME=your-cloud
CLOUDINARY_API_KEY=your-key
CLOUDINARY_API_SECRET=your-secret
CLOUDINARY_FOLDER=s19-medical

# Storage quotas for the Admin > Storage tab. The providers do not always report
# a plan limit (MongoDB reports none at all; Cloudinary returns 0 on the
# credit-based free plan), so these free-tier defaults are used to draw the bars
# when nothing else is available. Override only if you are on a paid plan.
#   MongoDB Atlas M0 (free) = 512 MB, Cloudinary free = 25 GB.
# MONGO_STORAGE_LIMIT_MB=512
# MONGO_STORAGE_LIMIT_GB=0.5
# CLOUDINARY_STORAGE_LIMIT_GB=25
# CLOUDINARY_BANDWIDTH_LIMIT_GB=25

# Optional: raises the free MyMemory translation quota (used by the admin
# testimonial auto-translate) from ~5,000 to ~50,000 words/day.
# MYMEMORY_EMAIL=info@s19herbalclinic.com

# Rate limiting (optional, recommended for production)
# Without these, rate limits (login, registration, contact form, newsletter,
# testimonials, uploads) are in-memory only and apply per server instance.
# Setting both Upstash Redis REST url+token makes limits shared/global across
# all serverless instances, which is what you want on Vercel.
# UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your-upstash-token

# Public site URL (used for metadata)
NEXT_PUBLIC_SITE_URL=https://www.s19herbalclinic.com/

# Clinic timezone. Used for every "what day is it" and "is this due" calculation
# in the portal. Must be an IANA zone name. Leave unset to use the clinic
# default of Africa/Douala (WAT, UTC+1, no daylight saving).
#
# This one matters more than it looks. On Vercel the runtime is UTC, which is an
# hour behind Bafoussam, so without this the portal reported the wrong calendar
# day between 23:00 and 00:00 UTC — badges, "today" filters and treatment
# reminders all off by one day in the late evening.
# CLINIC_TIME_ZONE=Africa/Douala

# Backups (lightweight emailed database backup)
# SMTP + ADMIN_EMAIL above are required. The attachment contains the full
# database (including health records): set the clinic's own protected mailbox.
# BACKUP_EMAIL_MAX_BYTES=26214400
# Optional end-to-end encryption of the emailed attachment using the clinic's
# age public key (starts with age1). Decrypt with the age CLI + secret key.
# BACKUP_AGE_RECIPIENTS=age1xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Backups (optional object-store archive pipeline — S3-compatible + KMS + age)
# Only configure when you have the bucket/KMS/age keys; the cron route runs
# this pipeline automatically when every variable below is present.
# BACKUP_S3_BUCKET=s19-backups
# BACKUP_S3_REGION=auto
# BACKUP_S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# BACKUP_S3_ACCESS_KEY_ID=...
# BACKUP_S3_SECRET_ACCESS_KEY=...
# BACKUP_S3_KMS_KEY_ID=...
# BACKUP_S3_FORCE_PATH_STYLE=true
# BACKUP_RETENTION_DAYS=35
# BACKUP_CLOUDINARY_PREFIXES=s19-medical
# Optional: BACKUP_CLOUDINARY_URL=cloudinary://key:secret@cloud or use CLOUDINARY_* above.
# Secret protecting the /api/cron/backups endpoint (send as Authorization: Bearer).
# CRON_SECRET=change-me