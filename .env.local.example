# MongoDB
MONGO_URL=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/s19-medical

# SMTP (e.g. Gmail, Zoho, Mailgun)
SMTP_HOST=smtp.zoho.com
SMTP_PORT=465
SMTP_USER=info@s19herbalclinic.com
SMTP_PASS=your-zoho-smtp-password
SMTP_FROM=S19 Herbal Clinic <info@s19herbalclinic.com>
ADMIN_EMAIL=info@s19herbalclinic.com

# Cloudinary
CLOUDINARY_CLOUD_NAME=your-cloud
CLOUDINARY_API_KEY=your-key
CLOUDINARY_API_SECRET=your-secret
CLOUDINARY_FOLDER=s19-medical

# Optional: raises the free MyMemory translation quota (used by the admin
# testimonial auto-translate) from ~5,000 to ~50,000 words/day.
# MYMEMORY_EMAIL=info@s19herbalclinic.com

# Rate limiting (optional, recommended for production)
# Without these, rate limits (login, registration, contact form, newsletter,
# testimonials, uploads) are in-memory only and apply per server instance.
# Setting both Upstash Redis REST url+token makes limits shared/global across
# all serverless instances, which is what you want on Vercel.
# UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your-upstash-token

# Public site URL (used for metadata)
NEXT_PUBLIC_SITE_URL=https://www.s19herbalclinic.com/

# Clinic timezone (used for every "what day is it / is this due" calculation in
# the portal and the automation engine). Must be an IANA zone name. Leave unset
# to use the clinic default of Africa/Douala (WAT, UTC+1, no daylight saving).
# Setting this is strongly recommended: without it the code assumes Bafoussam,
# and a future second clinic would otherwise be a code change.
# CLINIC_TIME_ZONE=Africa/Douala

# Backups (lightweight emailed database backup)
# SMTP + ADMIN_EMAIL above are required. The attachment contains the full
# database (including health records): set the clinic's own protected mailbox.
# BACKUP_EMAIL_MAX_BYTES=26214400
# Optional end-to-end encryption of the emailed attachment using the clinic's
# age public key (starts with age1). Decrypt with the age CLI + secret key.
# BACKUP_AGE_RECIPIENTS=age1xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Backups (optional object-store archive pipeline — S3-compatible + KMS + age)
# Only configure when you have the bucket/KMS/age keys; the cron route runs
# this pipeline automatically when every variable below is present.
# BACKUP_S3_BUCKET=s19-backups
# BACKUP_S3_REGION=auto
# BACKUP_S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# BACKUP_S3_ACCESS_KEY_ID=...
# BACKUP_S3_SECRET_ACCESS_KEY=...
# BACKUP_S3_KMS_KEY_ID=...
# BACKUP_S3_FORCE_PATH_STYLE=true
# BACKUP_RETENTION_DAYS=35
# BACKUP_CLOUDINARY_PREFIXES=s19-medical
# Optional: BACKUP_CLOUDINARY_URL=cloudinary://key:secret@cloud or use CLOUDINARY_* above.
# Secret protecting the /api/cron/backups endpoint (send as Authorization: Bearer).
# CRON_SECRET=change-me

# ── WhatsApp: SENDING ────────────────────────────────────────────────────────
# Meta Cloud API. Everything above this line is clinic setup; everything below is
# optional and each block is independent of the others. See
# docs/GETTING_CREDENTIALS.md for a step-by-step guide (client-facing) and
# docs/WHATSAPP_SETUP.md for detail.
#
# Both halves are needed for a useful number. Sending without receiving looks
# healthy and quietly discards every patient reply.
# WHATSAPP_ACCESS_TOKEN=EAAG...            # PERMANENT System User token, not the 24h temporary one
# WHATSAPP_PHONE_NUMBER_ID=123456789012345
# WHATSAPP_GRAPH_VERSION=v23.0             # optional, this is the default
# WHATSAPP_NAMESPACE=s19                   # optional, template name prefix

# ── WhatsApp: RECEIVING ──────────────────────────────────────────────────────
# Callback URL to save in the WhatsApp Manager:
#   https://www.s19herbalclinic.com/api/webhooks/whatsapp
# and subscribe to the "messages" field.
#
# WHATSAPP_APP_SECRET is a signature secret, not a password: an UNSET value makes
# the webhook refuse every delivery with 503 rather than skipping verification.
# That is deliberate - skipping the check would leave an unauthenticated write
# path into patient records. A half-configured number must fail loudly.
# WHATSAPP_APP_SECRET=...
# Any high-entropy string you choose. Must match the verify token saved in Meta.
# WHATSAPP_VERIFY_TOKEN=...

# ── Payments: Fapshi (mobile money, Cameroon) ────────────────────────────────
# One base URL with NO path suffix; request paths are built in code. Switching
# sandbox <-> live is a single change, which is why it is not hardcoded.
# FAPSHI_BASE_URL=https://sandbox.fapshi.com   # or https://live.fapshi.com
# FAPSHI_API_KEY=...                            # sent as the "apikey" header
# FAPSHI_USER_KEY=...                           # sent as the "apiuser" header
# REQUIRED. Fapshi echoes this back in the x-wh-secret header. The payment code
# fails closed without it: accepting an unverified "payment succeeded" callback
# lets anyone who finds the URL mark an order paid for free.
# FAPSHI_WEBHOOK_SECRET=...
# Do NOT set the Fapshi webhook URL until the payment module is built. Fapshi
# delivers each notification exactly once and never retries, so a wrong URL means
# a customer's money arrives with no confirmation, permanently.

# ── Treatment-plan automation (M3) ───────────────────────────────────────────
# Reminder derivation is INERT unless this is exactly "true". Unset is never
# "on": an unset value means no patient is ever messaged about a plan schedule.
# Confirm the clinic's cadences in docs/TREATMENT_PLAN_SCHEDULE.md before setting.
# TREATMENT_SCHEDULE_ENABLED=true