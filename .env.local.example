# MongoDB
MONGO_URL=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/s19-medical

# SMTP (e.g. Gmail, Zoho, Mailgun)
SMTP_HOST=smtp.zoho.com
SMTP_PORT=465
SMTP_USER=info@s19herbalclinic.com
SMTP_PASS=your-zoho-smtp-password
SMTP_FROM=S19 Herbal Clinic <info@s19herbalclinic.com>
ADMIN_EMAIL=info@s19herbalclinic.com

# Cloudinary
CLOUDINARY_CLOUD_NAME=your-cloud
CLOUDINARY_API_KEY=your-key
CLOUDINARY_API_SECRET=your-secret
CLOUDINARY_FOLDER=s19-medical

# Optional: raises the free MyMemory translation quota (used by the admin
# testimonial auto-translate) from ~5,000 to ~50,000 words/day.
# MYMEMORY_EMAIL=info@s19herbalclinic.com

# Public site URL (used for metadata)
NEXT_PUBLIC_SITE_URL=https://www.s19herbalclinic.com/

# Backups (lightweight emailed database backup)
# SMTP + ADMIN_EMAIL above are required. The attachment contains the full
# database (including health records): set the clinic's own protected mailbox.
# BACKUP_EMAIL_MAX_BYTES=26214400
# Optional end-to-end encryption of the emailed attachment using the clinic's
# age public key (starts with age1). Decrypt with the age CLI + secret key.
# BACKUP_AGE_RECIPIENTS=age1xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Backups (optional object-store archive pipeline — S3-compatible + KMS + age)
# Only configure when you have the bucket/KMS/age keys; the cron route runs
# this pipeline automatically when every variable below is present.
# BACKUP_S3_BUCKET=s19-backups
# BACKUP_S3_REGION=auto
# BACKUP_S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# BACKUP_S3_ACCESS_KEY_ID=...
# BACKUP_S3_SECRET_ACCESS_KEY=...
# BACKUP_S3_KMS_KEY_ID=...
# BACKUP_S3_FORCE_PATH_STYLE=true
# BACKUP_RETENTION_DAYS=35
# BACKUP_CLOUDINARY_PREFIXES=s19-medical
# Optional: BACKUP_CLOUDINARY_URL=cloudinary://key:secret@cloud or use CLOUDINARY_* above.
# Secret protecting the /api/cron/backups endpoint (send as Authorization: Bearer).
# CRON_SECRET=change-me